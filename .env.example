# Copie para .env e preencha só o que for usar. NUNCA coloque chaves neste arquivo (.env.example vai para o git).

# ── Bancos de imagem e vídeo (pnpm media) ──
# Pixabay: fotos e vídeos, grátis. https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# Unsplash: fotos. https://unsplash.com/developers (Access Key)
UNSPLASH_ACCESS_KEY=
# Pexels: fotos e vídeos. https://www.pexels.com/api/
PEXELS_API_KEY=

# ── Áudio de banco (pnpm audio:search / audio:get) ──
# Freesound (efeitos): https://freesound.org/apiv2/apply
FREESOUND_TOKEN=
# Jamendo (trilhas): https://devportal.jamendo.com
JAMENDO_CLIENT_ID=

# ── Locução (pnpm video voice) ── piper é local e não precisa de chave
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OPENAI_API_KEY=

# ── Tradução automática (pnpm video translate --auto) ──
DEEPL_API_KEY=
ANTHROPIC_API_KEY=

# ── Saída ──
# Raiz de entrega. Padrão: clientes/ do projeto. O vídeo vai para <EXPORT_DIR>/<client>/<slug>/<AAAA-MM-DD>/
EXPORT_DIR=
# Chromium alternativo para render (opcional)
REMOTION_BROWSER=
