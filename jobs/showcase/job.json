{
  "$schema": "../../schemas/job.schema.json",
  "slug": "showcase",
  "title": "MARCUSWD: vitrine do gerador de vídeos",
  "client": "marcuswd",
  "brand": "marcuswd",
  "lang": "pt-BR",
  "langs": ["pt-BR", "en"],
