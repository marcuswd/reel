{
  "$schema": "../../schemas/job.schema.json",
  "slug": "demo-30s",
  "title": "MARCUSWD: o que o gerador de vídeos faz",
  "client": "marcuswd",
  "brand": "marcuswd",
  "lang": "pt-BR",
  "formats": ["16:9", "9:16"],
  "pace": "fast",
  "music": { "mode": "generate", "mood": "tech", "bpm": 120 },
  "voice": { "provider": "piper", "voiceId": "pt_BR-faber-medium" },
  "captions": { "mode": "both", "style": "pop" },
  "overlays": { "logo": "top-right", "grain": true, "vignette": true, "progress": true },
  "scenes": [
    {
      "id": "abertura", "type": "cover", "logo": true,
      "title": "Vídeos que [vendem], gerados por código",
      "background": "aurora", "camera": "dolly",
      "voice": "Vídeos que vendem, gerados por código."
    },
    {
      "id": "roteiro", "type": "statement",
      "text": "Você escreve o [roteiro]. O resto é automático.",
      "background": "grid", "transition": "glitch",
      "voice": "Você escreve o roteiro. O resto é automático."
    },
    {
      "id": "camera", "type": "media",
      "media": { "src": "showcase/stock/dev-1.jpg", "focus": { "x": 0.5, "y": 0.5 } },
      "eyebrow": "Câmera virtual", "title": "Movimentos de [cinema]",
      "camera": "orbit", "transition": "whip",
      "voice": "Movimentos de câmera de cinema."
    },
    {
      "id": "marca", "type": "split",
      "media": { "src": "showcase/stock/edit-1.jpg", "focus": { "x": 0.5, "y": 0.45 } },
      "title": "Sua marca em [qualquer formato]",
      "bullets": ["Cores, fontes e logo", "16:9, 9:16, 1:1 e 4:5"],
      "background": "shapes", "transition": "lift", "camera": "push",
      "voice": "A sua marca, em qualquer formato de tela."
    },
    {
      "id": "numeros", "type": "stats",
      "items": [
        { "value": 11, "label": "tipos de cena" },
        { "value": 15, "label": "transições" },
        { "value": 100, "suffix": "%", "label": "trilha original" }
      ],
      "background": "particles", "transition": "bands",
      "voice": "Onze tipos de cena, quinze transições e trilha original."
    },
    {
      "id": "automatico", "type": "list", "icon": "check",
      "title": "No [piloto automático]",
      "items": ["Música no ritmo dos cortes", "Locução e legendas", "Vários idiomas"],
      "background": "mesh", "transition": "push",
      "voice": "Música no ritmo dos cortes, locução, legendas e vários idiomas."
    },
    {
      "id": "contato", "type": "cta",
      "title": "Bora fazer o [seu vídeo]?",
      "button": "marcuswd.dev",
      "background": "aurora", "transition": "iris",
      "voice": "Bora fazer o seu vídeo?"
    }
  ]
}
