{
  "name": "reel",
  "version": "0.8.1",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-fonts.mjs && tsx scripts/video.ts index",
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "video": "tsx scripts/video.ts",
    "media": "tsx scripts/media.ts",
    "brand": "tsx scripts/brand.ts",
    "transcribe": "tsx scripts/transcribe.ts",
    "sfx": "python scripts/sfx.py",
    "doctor": "tsx scripts/video.ts doctor",
    "audio:search": "node scripts/audio.mjs search",
    "audio:get": "node scripts/audio.mjs get",
    "skills": "npx -y skills add remotion-dev/skills --agent claude-code --yes"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@remotion/bundler": "4.0.534",
